# Required: your Mistral API key (https://console.mistral.ai)
MISTRAL_API_KEY=

# Optional: chat model (default: mistral-small-latest)
# MISTRAL_CHAT_MODEL=mistral-small-latest

# Required for /dashboard: password to view captured leads
DASHBOARD_PASSWORD=

# Optional: store leads in Supabase (run supabase/schema.sql first).
# Without these, leads are kept in memory and reset when the server restarts.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
