# Required: your Mistral API key (https://console.mistral.ai)
MISTRAL_API_KEY=

# Optional: chat model (default: mistral-small-latest)
# MISTRAL_CHAT_MODEL=mistral-small-latest

# Optional: Slack or Discord incoming-webhook URL for new-lead alerts
# LEAD_WEBHOOK_URL=

# Required for /dashboard: password to view captured leads
DASHBOARD_PASSWORD=

# Store leads in Supabase (required on Vercel/serverless; run supabase/schema.sql first).
# Without these, leads are kept in memory: fine for local dev, but they reset on restart
# and are not shared between serverless functions.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=sb_publishable_...        (the public publishable/anon key)
# SUPABASE_LEADS_SECRET=                 (long random string; its SHA-256 goes in schema.sql)
